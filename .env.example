# ===========================
# FinDost environment variables
# Copy this file to .env and fill in the values
# ===========================

# Database (PostgreSQL — Neon free tier)
# A direct connection is fine for local development.
# On Vercel or any serverless host, use Neon's POOLED connection string
# (the hostname contains "-pooler"). Otherwise every function instance opens
# its own pool and the database runs out of connections.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="replace-this-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# The authorized redirect URI must be added in the Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenAI (phase 5 — FinBot)
# OPENAI_API_KEY="sk-your-openai-key"

# Razorpay (phase 7 — payments)
# RAZORPAY_KEY_ID="rzp_test_xxx"
# RAZORPAY_KEY_SECRET="your-razorpay-secret"
# RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Resend (phase 6 — emails)
# RESEND_API_KEY="re_xxx"
