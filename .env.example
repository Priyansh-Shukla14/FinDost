# ===========================
# 🔐 FinDost Environment Variables
# Copy this file to .env and fill in the values
# ===========================

# 🗄️ Database (PostgreSQL — Neon free tier)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 🔑 NextAuth
NEXTAUTH_SECRET="kuch-bhi-random-string-daal-de-yahan"
NEXTAUTH_URL="http://localhost:3000"

# 🔐 Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 🤖 OpenAI (Phase 5 — FinBot ke liye)
# OPENAI_API_KEY="sk-your-openai-key"

# 💳 Razorpay (Phase 7 — Payments ke liye)
# RAZORPAY_KEY_ID="rzp_test_xxx"
# RAZORPAY_KEY_SECRET="your-razorpay-secret"
# RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# 📧 Resend (Phase 6 — Emails ke liye)
# RESEND_API_KEY="re_xxx"
