# ===========================
# FinDost environment variables
# Copy this file to .env and fill in the values
# ===========================

# Database (PostgreSQL — Neon free tier)
#
# LOCAL: use the DIRECT connection string. It is measurably faster than the
# pooled one for a single long-running dev server — PgBouncer adds a network
# hop, and the pgbouncer=true flag disables prepared statements so every query
# re-parses. On this project the 4-query dashboard load measured 350ms direct
# vs 779ms pooled.
#
# VERCEL (or any serverless host): use the POOLED string instead — its
# hostname contains "-pooler". Each function instance would otherwise open its
# own pool against the direct endpoint and exhaust Neon's connection limit.
# Add "?sslmode=require&pgbouncer=true" there.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Always the DIRECT connection string, in both environments.
# `prisma migrate` needs a real session, which PgBouncer's transaction
# pooling cannot provide.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="replace-this-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
# The authorized redirect URI must be added in the Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Gemini (phase 5 — FinBot and the receipt scanner)
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"
# Optional: override the model. Defaults to gemini-3.6-flash.
# GEMINI_MODEL="gemini-3.6-flash"
# Optional: daily AI request cap per user. Defaults to 100 free / 500 pro.
# AI_DAILY_LIMIT_FREE="100"
# AI_DAILY_LIMIT_PRO="500"

# Razorpay (phase 7 — payments)
# RAZORPAY_KEY_ID="rzp_test_xxx"
# RAZORPAY_KEY_SECRET="your-razorpay-secret"
# RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Resend (phase 6 — emails)
# RESEND_API_KEY="re_xxx"
