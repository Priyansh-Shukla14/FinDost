// FinDost database schema
// Defines the tables in the database and the columns on each one.
// Think of it as a blueprint for a set of spreadsheets — one model per sheet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// AUTH TABLES — required by NextAuth
// NextAuth uses these four tables to manage
// signup, login and sessions.
// =============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null for Google OAuth users, hashed for email signup
  plan          String    @default("free") // "free" or "pro"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships — these connect a user to all of their data
  accounts      Account[]
  sessions      Session[]
  expenses      Expense[]
  budgets       Budget[]
  categories    Category[]
  subscriptions Subscription[]
  goals         Goal[]
  taxEntries    TaxEntry[]
  aiMessages    Int       @default(0) // AI messages used today
  aiResetDate   DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================
// CORE TABLES — the app's main features
// =============================================

// Category — Food, Transport, Shopping, etc.
model Category {
  id        String    @id @default(cuid())
  name      String
  emoji     String
  color     String    @default("#10b981") // hex color for charts
  isDefault Boolean   @default(false) // system categories vs user-created
  userId    String?   // null = system default, set = user-created

  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  budgets   Budget[]

  @@unique([name, userId])
}

// Expense — a single spend
model Expense {
  id         String   @id @default(cuid())
  amount     Int      // stored in paise (₹150 = 15000 paise) to avoid float issues
  note       String?
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  categoryId String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([userId, date])
  @@index([userId, categoryId])
}

// Budget — a monthly limit per category
model Budget {
  id         String   @id @default(cuid())
  amount     Int      // in paise
  month      Int      // 1-12
  year       Int      // 2024, 2025...
  alertSent  Boolean  @default(false) // has the 80% alert already been sent?
  createdAt  DateTime @default(now())

  userId     String
  categoryId String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month, year])
}

// Subscription — recurring payments (Netflix, Spotify, etc.)
model Subscription {
  id          String   @id @default(cuid())
  name        String
  amount      Int      // in paise
  frequency   String   @default("monthly") // monthly, yearly
  nextDueDate DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Goal — savings goals (a trip, a new phone, etc.)
model Goal {
  id          String   @id @default(cuid())
  name        String
  targetAmount Int     // in paise
  savedAmount  Int     @default(0) // in paise
  deadline    DateTime?
  emoji       String   @default("🎯")
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// TaxEntry — Section 80C investment tracking
model TaxEntry {
  id        String   @id @default(cuid())
  type      String   // "PPF", "ELSS", "LIC", "NPS", etc.
  amount    Int      // in paise
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
